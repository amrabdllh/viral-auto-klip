# Viral Auto Klip - Environment Variables
# Copy to .env and fill your keys
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cuda
WHISPER_ALLOW_LARGE_ON_GPU=1
WHISPER_GPU_SAFE_VRAM_GB=5.5
WHISPER_CUDA_DEVICE_INDEX=0
YTDLP_COOKIES=cookies.txt

# Recommended: Groq (fastest for LLM scoring)
GROQ_API_KEY=gsk...

# Free/alternative providers for AI scoring
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Provider/model defaults
AI_PROVIDER=Groq
LLM_MODEL=llama-3.3-70b-versatile

# Optional / paid fallback
OPENAI_API_KEY=your_openai_api_key_here

# Optional: AssemblyAI for even better transcription (paid but excellent)
# ASSEMBLYAI_API_KEY=...

# Note: For production use, consider Klipers.pro API if they provide endpoints
# (check their docs after login)
CLIPPING_SOFTWARE_API_KEY=isi_key_kamu
